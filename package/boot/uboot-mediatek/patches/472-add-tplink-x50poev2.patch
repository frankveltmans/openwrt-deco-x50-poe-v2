+
+/dts-v1/;
+#include "mt7981.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+        #address-cells = <1>;
+        #size-cells = <1>;
+        model = "TP-Link Deco X50 POE v2";
+        compatible = "tplink,x50poev2", "mediatek,mt7981";
+
+        chosen {
+                stdout-path = &uart0;
+                tick-timer = &timer0;
+        };
+
+        memory@40000000 {
+                device_type = "memory";
+                reg = <0x40000000 0x20000000>;
+        };
+
+        keys {
+                compatible = "gpio-keys";
+
+                reset {
+                        label = "reset";
+                        gpios = <&pio 10 GPIO_ACTIVE_LOW>;
+                };
+        };
+
+        leds {
+                compatible = "gpio-leds";
+
+                led_red {
+                        label = "red";
+                        gpios = <&pio 9 GPIO_ACTIVE_HIGH>;
+                };
+
+                led_green {
+                        label = "green";
+                        gpios = <&pio 12 GPIO_ACTIVE_HIGH>;
+                };
+
+                led_blue {
+                        label = "blue";
+                        gpios = <&pio 28 GPIO_ACTIVE_HIGH>;
+                };
+        };
+};
+
+&uart0 {
+        status = "okay";
+};
+
+&eth {
+        status = "disabled";
+};
+
+&pio {
+        spi_flash_pins: spi0-pins-func-1 {
+                mux {
+                        function = "flash";
+                        groups = "spi0", "spi0_wp_hold";
+                };
+
+                conf-pu {
+                        pins = "SPI0_CS", "SPI0_HOLD", "SPI0_WP";
+                        drive-strength = <MTK_DRIVE_8mA>;
+                        bias-pull-up = <MTK_PUPD_SET_R1R0_11>;
+                };
+
+                conf-pd {
+                        pins = "SPI0_CLK", "SPI0_MOSI", "SPI0_MISO";
+                        drive-strength = <MTK_DRIVE_8mA>;
+                        bias-pull-down = <MTK_PUPD_SET_R1R0_11>;
+                };
+        };
+};
+
+&spi0 {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        pinctrl-names = "default";
+        pinctrl-0 = <&spi_flash_pins>;
+        status = "okay";
+        must_tx;
+        enhance_timing;
+        dma_ext;
+        ipm_design;
+        support_quad;
+        tick_dly = <2>;
+        sample_sel = <0>;
+
+        spi_nand@0 {
+                compatible = "spi-nand";
+                reg = <0>;
+                spi-max-frequency = <52000000>;
+
+                partitions {
+                compatible = "fixed-partitions";
+                #address-cells = <1>;
+                #size-cells = <1>;
+
+                        partition@0 {
+                                label = "boot";
+                                reg = <0x00 0x200000>;
+                                read-only;
+                        };
+
+                        partition@200000 {
+                                label = "u-boot-env";
+                                reg = <0x200000 0x100000>;
+                                read-only;
+                        };
+
+                        partition@300000 {
+                                label = "ubi0";
+                                reg = <0x300000 0x2a00000>;
+                        };
+
+                        partition@2d00000 {
+                                label = "ubi1";
+                                reg = <0x2d00000 0x2a00000>;
+                                read-only;
+                        };
+
+                        partition@5800000 {
+                                label = "ubi_factory_data";
+                                reg = <0x5800000 0x900000>;
+                                read-only;
+                        };
+                };
+        };
+};
+
+&watchdog {
+        status = "disabled";
+};
+
--- /dev/null
